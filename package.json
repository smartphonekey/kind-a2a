{
  "name": "aira-a2a-lab",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-reporting.mjs",
    "start:controller": "node dist/controller.js",
    "start:agyn": "./scripts/start-agyn.sh",
    "start:service": "node dist/service/main.js",
    "start:web": "bash scripts/start-web.sh",
    "build:web": "npm --prefix web run build",
    "test:web": "npm --prefix web test",
    "start:runner": "node dist/runner.js",
    "client": "node dist/client.js",
    "pretest": "npm run build && npm run docs:check",
    "test": "node --test dist/*.test.js tooling/code-map/*.test.mjs",
    "test:agyn": "node --test dist/agyn-backend.test.js",
    "test:adapter": "node --test dist/adapter.test.js",
    "test:fake-acp": "node --test dist/acp-harness.test.js",
    "test:live": "./scripts/verify-live.sh",
    "code:map": "node tooling/code-map/cli.mjs",
    "code:map:mcp": "node tooling/code-map/mcp.mjs",
    "docs:check": "node tooling/code-map/cli.mjs check",
    "test:code-map": "node --test tooling/code-map/*.test.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@agentclientprotocol/codex-acp": "1.11.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@kubernetes/client-node": "1.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "smol-toml": "1.8.0",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/node": "22.15.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "5.8.3"
  }
}
