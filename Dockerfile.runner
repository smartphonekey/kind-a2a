FROM node:22-bookworm-slim
RUN groupadd --gid 10001 runner && useradd --uid 10001 --gid 10001 --create-home runner
RUN npm install --global @openai/codex@0.153.4
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY dist/common.js dist/runner.js ./
COPY scripts/runner-entrypoint.sh /usr/local/bin/aira-runner
RUN chmod 0755 /usr/local/bin/aira-runner
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/aira-runner"]
