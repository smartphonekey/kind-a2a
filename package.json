{
  "name": "aira-a2a-lab",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:controller": "node dist/controller.js",
    "start:agyn": "./scripts/start-agyn.sh",
    "start:runner": "node dist/runner.js",
    "client": "node dist/client.js",
    "pretest": "npm run build",
    "test": "node --test dist/*.test.js",
    "test:agyn": "node --test dist/agyn-backend.test.js",
    "test:adapter": "node --test dist/adapter.test.js",
    "test:fake-acp": "node --test dist/acp-harness.test.js",
    "test:live": "./scripts/verify-live.sh"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@agentclientprotocol/codex-acp": "1.11.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@kubernetes/client-node": "1.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
