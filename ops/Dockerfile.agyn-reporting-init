# Trusted-local integration image. Production must pin reviewed image digests.
FROM node:22-bookworm-slim AS node
RUN mkdir /node-libs && cp -L /usr/lib/*-linux-gnu/libstdc++.so.6 /usr/lib/*-linux-gnu/libgcc_s.so.1 /node-libs/
FROM ghcr.io/agynio/agynd-cli-init:0.24.2
COPY agynd /opt/agyn/agynd
COPY --from=node /usr/local/bin/node /opt/agyn/node.bin
COPY --from=node /node-libs/ /opt/agyn/node-libs/
RUN printf '#!/bin/sh\nexport LD_LIBRARY_PATH=/agyn/lib\nexec /agyn/bin/node.bin "$@"\n' > /opt/agyn/node
ENTRYPOINT ["/bin/sh", "-c", "set -e; mkdir -p /agyn/bin /agyn/lib /agyn/terminfo /agyn/run; chmod 0777 /agyn/run; cp /opt/agyn/agynd /opt/agyn/agynd-trace-hook /opt/agyn/tmux /opt/agyn/node /opt/agyn/node.bin /agyn/bin/; chmod 0755 /agyn/bin/agynd /agyn/bin/agynd-trace-hook /agyn/bin/tmux /agyn/bin/node /agyn/bin/node.bin; cp /opt/agyn/node-libs/* /agyn/lib/; cp -R /opt/agyn/terminfo/. /agyn/terminfo/; cp /opt/agyn/tmux.conf /agyn/tmux.conf; chmod 0644 /agyn/tmux.conf"]
